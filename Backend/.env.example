# ============================================
# AgendaFlow — Variáveis de Ambiente
# ============================================
# Copie este arquivo como .env e preencha os valores

# ─── Banco de Dados ─────────────────────────
# PostgreSQL (pode ser Supabase, Neon, etc.)
DATABASE_URL="postgresql://user:password@host:5432/database"

# ─── Google OAuth (Google Calendar API) ────
# Criar credenciais em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# URL de callback (deve estar autorizada no Google Cloud Console)
GOOGLE_REDIRECT_URI="http://localhost:3333/api/google/callback"

# ─── Autenticação JWT ──────────────────────
# Gere com: openssl rand -hex 32
JWT_SECRET=""

# ─── Email (Nodemailer + Gmail SMTP) ───────
# Para Gmail: ative 2FA e crie senha de app em:
#   https://myaccount.google.com/apppasswords
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="AgendaFlow <no-reply@agendaflow.com>"

# ─── Groq (Assistente de IA) ───────────────
# Crie sua chave em: https://console.groq.com/keys
GROQ_API_KEY=""

# ─── URLs ───────────────────────────────────
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3333"
